+    def _compileClassicContextual(
+        self, font, table, entryTransitions, newStateOffset, substOffset
+    ):
+        glyphOrder = font.getGlyphOrder()
+        numGlyphs = len(glyphOrder)
+        known = set(glyphOrder)
