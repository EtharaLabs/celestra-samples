+            limit = min(numGlyphs, size // 2 - offset)
+            lookup = {}
+            if first < limit:
+                values = self._readClassicArray(
+                    readerAt(2 * (offset + first)), "H", 2, limit - first
+                )
+                glyphs = font.getGlyphNameMany(range(first, limit))
+                lookup = dict(zip(glyphs, font.getGlyphNameMany(values)))
+            table.PerGlyphLookups.append(lookup)
