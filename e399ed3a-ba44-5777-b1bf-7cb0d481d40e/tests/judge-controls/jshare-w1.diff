+_MORT_ACTIONS = {
+    RearrangementMorphAction: MortRearrangementMorphAction,
+    ContextualMorphAction: MortContextualMorphAction,
+    LigatureMorphAction: MortLigatureMorphAction,
+    InsertionMorphAction: MortInsertionMorphAction,
