+def _bare(expr: Any) -> Any:
+    """Return ``expr`` without coordinates that index no dimension.
+
+    Component expressions carry per-name labels such as ``bus`` or
+    ``bus_carrier``; operands from different components disagree on them, and
+    linopy's v1 semantics refuses to merge conflicting labels.
+    """
+    indexed = set(expr.dims).union(*(expr.indexes[d].names for d in expr.indexes))
+    extra = [k for k in expr.coords if k not in indexed]
+    return expr.drop_vars(extra) if extra else expr
+
+
+def _grouped_sum(expr: Any, grouping: pd.DataFrame) -> Any:
+    """Sum ``expr`` over ``grouping`` and keep the group labels as an index.
+
+    Under v1 a grouping frame yields an integer ``group`` dimension with the
+    frame's columns as auxiliary coordinates; the legacy semantics yield one
+    index over those columns, which the callers rely on.
+    """
+    res = expr.groupby(grouping).sum()
+    columns = [col for col in grouping.columns if col in res.coords]
+    if not columns or "group" in columns:
+        return res
+    labels = [res.coords[col].values for col in columns]
+    if len(columns) > 1:
+        index = pd.MultiIndex.from_arrays(labels, names=columns)
+        coords = Coordinates.from_pandas_multiindex(index, "group")
+    else:
+        coords = {"group": pd.Index(labels[0], name="group")}
+    return res.drop_vars(columns + ["group"]).assign_coords(coords)
+
+
+def _merged(exprs: Any, **kwargs: Any) -> Any:
+    """Merge expressions whose ``group`` index has several levels.
+
+    v1 compares the levels of a multi-level index like auxiliary labels, so
+    groups with different ``bus`` values could not be combined; the groups are
+    merged as plain tuples and their levels restored afterwards.
+    """
+    names = None
+    flat = []
+    for expr in exprs:
+        expr = _bare(expr)
+        index = expr.indexes.get("group")
+        if isinstance(index, pd.MultiIndex):
+            names = list(index.names)
+            expr = expr.drop_vars(["group", *names]).assign_coords(
+                group=pd.Index(index.to_flat_index(), name="group")
+            )
+        flat.append(expr)
+    res = ln.merge(flat, **kwargs)
+    if names is None or "group" not in res.dims:
+        return res
+    tuples = pd.MultiIndex.from_tuples(list(res.indexes["group"]), names=names)
+    coords = Coordinates.from_pandas_multiindex(tuples, "group")
+    return res.drop_vars("group").assign_coords(coords)
