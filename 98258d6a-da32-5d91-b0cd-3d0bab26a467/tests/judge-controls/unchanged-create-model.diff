+def _on_model_snapshots(create_model: Callable) -> Callable:
+    """Hand ``create_model`` the snapshots in the layout the new model uses."""
+
+    @functools.wraps(create_model)
+    def build(
+        self: OptimizationAccessor,
+        snapshots: Sequence | None = None,
+        *args: Any,
+        **kwargs: Any,
+    ) -> Model:
+        sns = as_index(self._n, snapshots, "snapshots")
+        return create_model(self, model_snapshots(self._n, sns), *args, **kwargs)
+
+    return build
+
+
+OptimizationAccessor.create_model = _on_model_snapshots(  # type: ignore[method-assign]
+    OptimizationAccessor.create_model
