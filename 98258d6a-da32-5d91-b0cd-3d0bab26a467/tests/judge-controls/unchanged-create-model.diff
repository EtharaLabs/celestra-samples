+"""Flat snapshot labels for models of multi-period networks.
+
+linopy's v1 semantics refuse a pandas MultiIndex as a model dimension. A network
+with investment periods keeps its (period, timestep) MultiIndex, and a model built
+for it may instead use one ``snapshot`` level whose labels are the (period,
+timestep) tuples, followed by ``period`` and ``timestep`` coordinates. While such a
+model is being built or read, component data is handed out with those labels.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import linopy
+import numpy as np
+import pandas as pd
+import xarray as xr
+
+from pypsa._options import options
+
+if TYPE_CHECKING:
+    from pypsa import Network
+
+CHOICES = ("auto", "flat", "multiindex")
+
+
+def chosen_layout() -> str:
+    """The layout ``optimization.model_snapshot_index`` asks for, with "auto" resolved."""
+    value = options.optimization.model_snapshot_index
+    if value not in CHOICES:
+        msg = (
+            f"options.optimization.model_snapshot_index must be one of {CHOICES}, "
+            f"not {value!r}."
+        )
+        raise ValueError(msg)
+    if value == "auto":
+        return "flat" if linopy.options["semantics"] == "v1" else "multiindex"
+    return value
+
+
+def tuple_index(sns: pd.Index) -> pd.Index:
+    """``sns`` as one level of tuples named ``snapshot``."""
+    return pd.Index(list(sns), tupleize_cols=False, name="snapshot")
+
+
+def is_tuple_index(index: pd.Index) -> bool:
+    return (
+        not isinstance(index, pd.MultiIndex)
+        and len(index) > 0
+        and isinstance(index[0], tuple)
+    )
+
+
+def model_snapshots(n: Network, sns: pd.Index) -> pd.Index:
+    """The snapshots a new model of ``n`` uses for ``sns``, recording the choice on ``n``."""
+    layout = chosen_layout()
+    if isinstance(sns, pd.MultiIndex) and layout == "flat":
+        n._flat_snapshots = sns
+        return tuple_index(sns)
+    n._flat_snapshots = None
+    return sns
+
+
+def flattening(n: Any) -> bool:
+    return getattr(n, "_flat_snapshots", None) is not None
+
+
+def flatten(da: Any) -> Any:
+    """Relabel a MultiIndex ``snapshot`` dimension of ``da`` with tuples plus level coordinates."""
+    if not isinstance(da, xr.DataArray | xr.Dataset) or "snapshot" not in da.dims:
+        return da
+    index = da.indexes["snapshot"]
+    if not isinstance(index, pd.MultiIndex):
+        return da
+    levels = {name: ("snapshot", index.get_level_values(name).to_numpy()) for name in index.names}
+    stripped = da.drop_vars(["snapshot", *index.names])
+    return stripped.assign_coords(snapshot=tuple_index(index)).assign_coords(levels)
+
+
+def stack(index: pd.Index, names: list[str] | None = None) -> pd.Index:
+    """Turn tuple labels back into a MultiIndex; leave any other index alone."""
+    if not is_tuple_index(index):
+        return index
+    return pd.MultiIndex.from_tuples(list(index), names=names or ["period", "timestep"])
+
+
+def periods_of(index: pd.Index) -> np.ndarray | None:
+    """The investment period of every snapshot label, or None for single-period labels."""
+    if isinstance(index, pd.MultiIndex) and "period" in index.names:
+        return index.get_level_values("period").to_numpy()
+    if is_tuple_index(index):
+        return np.array([label[0] for label in index])
+    return None
+
+
+def unique_periods(sns: pd.Index) -> pd.Index:
+    """The investment periods ``sns`` spans, in order of first appearance."""
+    return pd.Index(pd.unique(periods_of(sns)), name="period")
+
+
+def in_period(sns: pd.Index, period: Any) -> pd.Index:
+    """The labels of ``sns`` that belong to investment period ``period``."""
+    return sns[periods_of(sns) == period]
+
+
+def period_slice(da: xr.DataArray, period: Any) -> xr.DataArray:
+    """``da`` restricted to one investment period, whichever snapshot layout it has."""
+    if "period" in da.dims:
+        return da.sel(period=period)
+    return da.isel(snapshot=(da["period"] == period).to_numpy())
+
+
+def any_over_time(da: xr.DataArray) -> xr.DataArray:
+    """Reduce over every time dimension ``da`` has left."""
+    return da.any(dim=[d for d in ("snapshot", "timestep") if d in da.dims])
+
+
+def relabel(obj: Any, sns: pd.Index, axis: int = 0) -> Any:
+    """Give a pandas object indexed by the network's snapshots the model's labels."""
+    if not is_tuple_index(sns):
+        return obj
+    return obj.set_axis(tuple_index(obj.axes[axis]), axis=axis)
+
+
+def model_view(obj: Any, sns: pd.Index) -> Any:
+    """``obj``, indexed by the network's snapshots, at ``sns`` and with the model's labels."""
+    return relabel(obj.loc[stack(sns)], sns)
+
+
+def snapshot_array(values: Any, sns: pd.Index) -> xr.DataArray:
+    """A one-dimensional array over ``sns``, carrying level coordinates for tuple labels."""
+    if not is_tuple_index(sns):
+        return xr.DataArray(values, coords=[sns], dims=["snapshot"])
+    return flatten(xr.DataArray(values, coords=[stack(sns).rename(["period", "timestep"])], dims=["snapshot"]))
+
+
+def unflatten(da: xr.DataArray) -> xr.DataArray:
+    """Undo :func:`flatten`: rebuild the (period, timestep) MultiIndex from tuple labels."""
+    if "snapshot" not in da.dims or not is_tuple_index(da.indexes["snapshot"]):
+        return da
+    index = stack(da.indexes["snapshot"])
+    stripped = da.drop_vars(["snapshot", *[n for n in index.names if n in da.coords]])
+    return stripped.assign_coords(xr.Coordinates.from_pandas_multiindex(index, "snapshot"))
+
+
+def built_snapshots(n: Network) -> pd.Index:
+    """The snapshots the network's current model was built over, as that model labels them."""
+    labels = n.model.parameters.snapshots.to_index()
+    return tuple_index(labels) if is_tuple_index(labels) else labels
+
+
+def model_array(frame: pd.DataFrame, sns: pd.Index) -> Any:
+    """A frame with one row per snapshot of ``sns``, as the array the model reads."""
+    if not is_tuple_index(sns):
+        return frame
+    name = frame.columns.name or "name"
+    data = xr.DataArray(frame.to_numpy(), dims=["snapshot", name], coords={name: frame.columns})
+    return data.assign_coords(snapshot_array(np.zeros(len(sns)), sns).coords)
