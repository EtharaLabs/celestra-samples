+def _flat_snapshot_index(sns: pd.MultiIndex) -> pd.Index:
+    """Return the snapshots as a flat index labelled by ``(period, timestep)`` tuples."""
+    return pd.Index(sns.to_flat_index(), name="snapshot", tupleize_cols=False)
+
+
+def _flat_snapshot_coords(sns: pd.MultiIndex) -> xr.Coordinates:
+    """Build a flat ``snapshot`` coordinate with the levels as auxiliary coordinates."""
+    coords = {"snapshot": _flat_snapshot_index(sns)}
+    coords.update({lvl: ("snapshot", sns.get_level_values(lvl)) for lvl in sns.names})
+    return xr.Coordinates(coords)
+
+
+def _flatten_snapshots(obj: Any) -> Any:
+    """Replace a MultiIndex ``snapshot`` dimension by its flat representation.
+
+    Coordinate order is kept, with the former levels following ``snapshot``.
+    """
+    sns = obj.indexes.get("snapshot")
+    if not isinstance(sns, pd.MultiIndex):
+        return obj
+    levels = list(sns.names)
+    order = []
+    for name in obj.coords:
+        if name == "snapshot":
+            order += ["snapshot", *levels]
+        elif name not in levels:
+            order.append(name)
+    flat = obj.drop_vars(["snapshot", *levels]).assign_coords(
+        _flat_snapshot_coords(sns)
+    )
+    coords = xr.Coordinates(
+        {name: flat.coords[name].variable for name in order},
+        indexes=dict(flat.xindexes),
+    )
+    return flat.drop_vars(list(flat.coords)).assign_coords(coords)
+
+
+def _unflatten_snapshots(obj: Any, levels: Sequence[str] | None = None) -> Any:
+    """Restore a MultiIndex ``snapshot`` dimension from its flat representation.
+
+    Levels are taken from the auxiliary snapshot coordinates, or from ``levels``
+    if those are missing.
+    """
+    sns = obj.indexes.get("snapshot")
+    if sns is None or isinstance(sns, pd.MultiIndex) or sns.dtype != object:
+        return obj
+    if not len(sns) or not all(isinstance(s, tuple) for s in sns):
+        return obj
+    aux = [
+        name
+        for name, coord in obj.coords.items()
+        if name != "snapshot" and coord.dims == ("snapshot",)
+    ]
+    names = aux if aux else list(levels or [])
+    if len(names) != len(sns[0]):
+        return obj
+    multi = pd.MultiIndex.from_tuples(sns, names=names)
+    multi.name = "snapshot"
+    restored = obj.drop_vars(["snapshot", *aux])
+    return restored.assign_coords(
+        xr.Coordinates.from_pandas_multiindex(multi, "snapshot")
+    )
+
