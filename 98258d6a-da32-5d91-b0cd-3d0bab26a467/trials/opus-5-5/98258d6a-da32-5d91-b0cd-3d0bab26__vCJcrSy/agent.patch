+def _model_is_flat(m: Model) -> bool:
+    """Whether the model labels multi-period snapshots by a flat index."""
+    if "snapshots" not in m.parameters:
+        return False
+    snapshots = m.parameters["snapshots"]
+    return "period" in snapshots.coords and not isinstance(
+        snapshots.indexes.get("snapshot"), pd.MultiIndex
+    )
+
