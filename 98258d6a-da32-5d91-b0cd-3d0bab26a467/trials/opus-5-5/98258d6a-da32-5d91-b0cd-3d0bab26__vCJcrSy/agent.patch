+    value = options.optimization.model_snapshot_index
+    if value not in MODEL_SNAPSHOT_INDEX_VALUES:
+        msg = (
+            f"Invalid value {value!r} for option "
+            "'optimization.model_snapshot_index'. Must be one of "
+            f"{', '.join(map(repr, MODEL_SNAPSHOT_INDEX_VALUES))}."
