+def _group_as_multiindex(expr: LinearExpression) -> LinearExpression:
+    """Label a grouped dimension by a MultiIndex of its keys.
+
+    Under linopy's v1 semantics a groupby over multiple keys yields a flat ``group``
+    dimension with the keys as auxiliary coordinates instead of a MultiIndex.
+    """
+    index = expr.indexes.get("group")
+    if index is None or isinstance(index, pd.MultiIndex):
+        return expr
+    keys = [
+        name
+        for name, coord in expr.coords.items()
+        if name != "group" and coord.dims == ("group",)
+    ]
+    if not keys:
+        return expr
+    groups = pd.MultiIndex.from_arrays(
+        [expr.coords[key].values for key in keys], names=keys
+    )
+    return expr.drop_vars(["group", *keys]).assign_coords(
+        Coordinates.from_pandas_multiindex(groups, "group")
+    )
+
+
+def _leading_dim(expr: LinearExpression, dim: str) -> LinearExpression:
+    """Make `dim` the first dimension of `expr`.
+
+    The dimension order of linopy expressions follows the order of their coordinates.
+    """
+    if expr.dims[0] == dim:
+        return expr
+    data = expr.data
+    coords = data.coords
+    names = [k for k, c in coords.items() if dim in c.dims]
+    names += [k for k, c in coords.items() if dim not in c.dims]
+    ordered = Coordinates(
+        {k: coords[k].variable for k in names}, indexes=dict(data.xindexes)
+    )
+    variables = {k: v.variable.transpose(dim, ...) for k, v in data.data_vars.items()}
+    return LinearExpression(Dataset(coords=ordered).assign(variables), expr.model)
+
+
+def _sum_aligned(*exprs: Any) -> LinearExpression:
+    """Sum expressions over the union of their labels, absent labels count as zero."""
+    exprs_ = [e.to_linexpr() if isinstance(e, Variable) else e for e in exprs]
+    if len(exprs_) == 1:
+        return exprs_[0]
+    return ln.merge(exprs_, join="outer")
 
 
