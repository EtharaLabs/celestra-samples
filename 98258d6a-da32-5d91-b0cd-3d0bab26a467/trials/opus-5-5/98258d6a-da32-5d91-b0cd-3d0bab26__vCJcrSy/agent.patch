+def _network_snapshots(n: Network, sns: pd.Index) -> pd.Index:
+    """Convert model snapshots back to the network's snapshot index."""
+    if not isinstance(n.snapshots, pd.MultiIndex):
+        return sns.rename(n.snapshots.name)
+    multi = pd.MultiIndex.from_tuples(list(sns), names=n.snapshots.names)
+    multi.name = n.snapshots.name
+    return multi
+
+
+def _as_model_snapshots(n: Network, obj: Any) -> Any:
+    """Convert snapshot-indexed data to the snapshot representation of the model.
+
+    Supports snapshot indexes, pandas objects indexed by snapshots and xarray
+    objects with a snapshot dimension. Other objects are returned unchanged.
+    """
+    if not _model_is_flat(n.model):
+        return obj
+    if isinstance(obj, pd.MultiIndex):
+        return _flat_snapshot_index(obj)
+    if isinstance(obj, pd.Series | pd.DataFrame):
+        if isinstance(obj.index, pd.MultiIndex) and obj.index.names == list(
+            n.snapshots.names
+        ):
+            return obj.set_axis(_flat_snapshot_index(obj.index), axis=0)
+        return obj
